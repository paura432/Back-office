# TrackFlow development stack configuration
# Copy to .env and adjust values for your local environment.
# NEVER commit the .env file — it is ignored by Git.

# ---- Ports (host side, bound to loopback only) ----
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
API_PORT=8000

# ---- PostgreSQL (db service) ----
POSTGRES_DB=trackflow
POSTGRES_USER=trackflow
POSTGRES_PASSWORD=trackflow_dev

# ---- Business performance reporting (services/reporting) ----
# DSN of a login role that is a member of reporting_reader (never a superuser).
# From the api container, the local Supabase database is host.docker.internal:54322.
# Leave empty to keep /reporting/* answering 503.
REPORTING_READ_DATABASE_DSN=
