# TrackFlow development stack configuration
# Copy to .env and adjust values for your local environment.
# NEVER commit the .env file — it is ignored by Git.

# ---- Ports (host side, bound to loopback only) ----
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
API_PORT=8000

# ---- PostgreSQL (db service) ----
POSTGRES_DB=trackflow
POSTGRES_USER=trackflow
POSTGRES_PASSWORD=trackflow_dev